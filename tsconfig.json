{
  "extends": "expo/tsconfig.base",
  "exclude": ["_old", "node_modules"],
  "compilerOptions": {
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "jsx": "react-native",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "target": "esnext",
    "typeRoots": ["./types", "./node_modules/@types"]
  }
}
